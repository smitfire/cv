<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ basics.name }} | {{ headline }}</title>
  <style>
    /* ATS-safe: single column, no tables, standard fonts, no graphics. Look borrowed from career-ops. */
    @page { size: A4; margin: 0.6in; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { print-color-adjust: exact; }
    body {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 11px;
      line-height: 1.5;
      color: #1a1a2e;
    }
    a { color: inherit; text-decoration: none; white-space: nowrap; }
    strong { font-weight: 600; color: #1a1a1a; }

    .header { margin-bottom: 18px; }
    h1 { font-size: 28px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 4px; }
    .headline { font-size: 12.5px; color: #444; margin-bottom: 6px; }
    .header-gradient {
      height: 2px; border-radius: 1px; margin-bottom: 10px;
      background: linear-gradient(to right, #15808e, #7322c3);
    }
    .contact-row { font-size: 10.5px; line-height: 1.6; color: #555; }
    .contact-row span { white-space: nowrap; }
    .contact-row span + span:before { content: "|"; color: #ccc; margin: 0 10px; }

    .section { margin-bottom: 16px; }
    h2 {
      font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
      color: #15808e; line-height: 1.2;
      border-bottom: 1.5px solid #e2e2e2; padding-bottom: 4px; margin-bottom: 10px;
    }

    .summary { line-height: 1.65; color: #2f2f2f; }

    .competencies { display: flex; flex-wrap: wrap; gap: 7px; }
    .competency-tag {
      font-size: 10px; font-weight: 500; color: #13707c;
      background: #edf6f7; border: 1px solid #d4eaed; border-radius: 3px; padding: 3px 9px;
    }

    .job { margin-bottom: 12px; }
    .job-header { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
    .job-company { font-size: 12.5px; font-weight: 600; color: #7322c3; }
    .job-period, .edu-year { font-size: 10.5px; color: #777; white-space: nowrap; }
    .job-role { font-weight: 600; color: #333; }
    .job-role .job-location { font-weight: 400; font-size: 10px; color: #888; }
    .job-blurb { font-size: 10.5px; font-style: italic; color: #555; margin-top: 1px; }
    .job ul, ul.achievements { padding-left: 16px; margin-top: 4px; }
    .job li, ul.achievements li { font-size: 10.5px; line-height: 1.55; color: #333; margin-bottom: 3px; }
    .job-stack { font-size: 10px; color: #666; }
    .job-stack .label, .skill-category { font-weight: 600; color: #333; }

    .project { margin-bottom: 8px; }
    .project-title { font-size: 11.5px; font-weight: 600; color: #7322c3; }
    .project-desc { font-size: 10.5px; color: #444; line-height: 1.55; }

    .edu-item { margin-bottom: 6px; }
    .edu-header { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
    .edu-title { font-weight: 600; color: #333; }
    .edu-org { font-weight: 500; color: #7322c3; }
    .edu-location { font-size: 10px; color: #888; }

    .skill-item { font-size: 10.5px; color: #444; margin-bottom: 5px; }

    /* Keep a role whole so its header is never stranded above bullets on the next page. */
    .header, .job, .edu-item, .skill-item, .competency-tag { break-inside: avoid; }
    h2, .job-header, .job-role, .project-title { break-after: avoid; }
  </style>
</head>
<body>

  <div class="header">
    <h1>{{ basics.name }}</h1>
    <div class="headline">{{ headline }}</div>
    <div class="header-gradient"></div>
    <div class="contact-row">
      <span>{{ basics.phone }}</span>
      <span><a href="mailto:{{ basics.email }}">{{ basics.email }}</a></span>
      <span><a href="{{ basics.linkedin }}">{{ basics.linkedin | replace('https://', '') | replace('www.', '') | trim('/') }}</a></span>
      {%- if basics.get('github') %}
      <span><a href="{{ basics.github }}">{{ basics.github | replace('https://', '') | trim('/') }}</a></span>
      {%- endif %}
      {%- if basics.get('sites') and basics.get('sites').get('personal') %}
      <span><a href="{{ basics.sites.personal }}">{{ basics.sites.personal | replace('https://', '') | trim('/') }}</a></span>
      {%- endif %}
    </div>
    <div class="contact-row">{{ basics.location }}</div>
  </div>

  <div class="section">
    <h2>Professional Summary</h2>
    <p class="summary">{{ summary | metric_emphasis }}</p>
  </div>

  {%- if competencies %}
  <div class="section">
    <h2>Core Competencies</h2>
    <div class="competencies">
      {%- for c in competencies %}
      <span class="competency-tag">{{ c }}</span>
      {%- endfor %}
    </div>
  </div>
  {%- endif %}

  <div class="section">
    <h2>Work Experience</h2>
    {%- for role in experience %}
    <div class="job">
      <div class="job-header">
        <span class="job-company">{{ role.company }}</span>
        <span class="job-period">{{ role.start_str }} - {{ role.end_str }}</span>
      </div>
      <div class="job-role">{{ role.role }}{% if role.location %} <span class="job-location">· {{ role.location }}</span>{% endif %}</div>
      {%- if role.blurb %}
      <div class="job-blurb">{{ role.blurb }}</div>
      {%- endif %}
      {%- if role.bullets %}
      <ul>
        {%- for b in role.bullets %}
        <li>{{ b | metric_emphasis }}</li>
        {%- endfor %}
      </ul>
      {%- endif %}
      {%- if role.stack %}
      <div class="job-stack"><span class="label">Stack:</span> {{ role.stack | join(', ') }}</div>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>

  {%- if key_achievements %}
  <div class="section">
    <h2>Selected Achievements</h2>
    <ul class="achievements">
      {%- for a in key_achievements %}
      <li>{{ a | metric_emphasis }}</li>
      {%- endfor %}
    </ul>
  </div>
  {%- endif %}

  {%- if projects %}
  <div class="section">
    <h2>Projects</h2>
    {%- for p in projects %}
    <div class="project">
      <div class="project-title">{{ p.title }}</div>
      <div class="project-desc">{{ p.blurb }}</div>
    </div>
    {%- endfor %}
  </div>
  {%- endif %}

  <div class="section">
    <h2>Education</h2>
    {%- for e in education %}
    <div class="edu-item">
      <div class="edu-header">
        <div class="edu-title">{{ e.degree }} <span class="edu-org">{{ e.school }}</span></div>
        <div class="edu-year">{{ e.start }}{% if e.end and e.end != e.start %} - {{ e.end }}{% endif %}</div>
      </div>
      {%- if e.location %}
      <div class="edu-location">{{ e.location }}</div>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>

  <div class="section">
    <h2>Skills</h2>
    {%- for s in skills %}
    <div class="skill-item"><span class="skill-category">{{ s.label }}:</span> {{ s['items'] | join(', ') }}</div>
    {%- endfor %}
    <div class="skill-item"><span class="skill-category">Languages:</span>
      {%- for l in languages %} {{ l.name }} ({{ l.level }}){% if not loop.last %},{% endif %}{% endfor %}</div>
  </div>

</body>
</html>
